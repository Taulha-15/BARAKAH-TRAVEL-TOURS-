@page
@{
    ViewData["Title"] = "Contact Us";
}

<section class="contact-hero">
    <div class="contact-container">
        <span class="contact-label">WE'RE HERE TO HELP</span>

        <h1>Get in Touch</h1>

        <p>
            Have questions about your Umrah journey?
            Our team is here to guide you.
        </p>
    </div>
</section>

<section class="contact-section">
    <div class="contact-container">

        <div class="contact-heading">
            <span class="contact-label">CONTACT BARAKAH TRAVEL TOURS</span>

            <h2>Begin Your Journey With Confidence</h2>

            <p>
                Whether you're exploring Umrah packages,
                requesting a registration code or preparing
                your travel application, we're happy to assist.
            </p>
        </div>

        <div class="contact-grid">

                <!-- YUSUF WHATSAPP -->
                <article class="contact-card">
                    <div class="contact-icon">☎</div>

                    <h3>Yusuf Safudien</h3>

                    <p>
                        Contact Yusuf for assistance with
                        Umrah packages and travel enquiries.
                    </p>

                    <p class="contact-detail">
                        074 046 4101
                    </p>

                    <a href="https://wa.me/27740464101"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="contact-whatsapp-button">
                        Chat on WhatsApp
                    </a>
                </article>

                <!-- ANEEQAH WHATSAPP -->
                <article class="contact-card">
                    <div class="contact-icon">☎</div>

                    <h3>Aneeqah Fisher</h3>

                    <p>
                        Contact Aneeqah for assistance with
                        customer registration and general enquiries.
                    </p>

                    <p class="contact-detail">
                        074 504 4259
                    </p>

                    <a href="https://wa.me/27745044259"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="contact-whatsapp-button">
                        Chat on WhatsApp
                    </a>
                </article>

                <!-- EMAIL -->
                <article class="contact-card">
                    <div class="contact-icon">✉</div>

                    <h3>Email Our Team</h3>

                    <p>
                        Send us an email for Umrah travel
                        information and assistance.
                    </p>

                    <p class="contact-detail contact-email">
                        barakahttsa@gmail.com
                    </p>

                    <a href="mailto:barakahttsa@gmail.com"
                       class="contact-email-button">
                        Send Email
                    </a>
                </article>

            </div>


        </div>
</section>

<section class="contact-bottom">
    <div class="contact-container">
        <h2>Your Sacred Journey Starts Here</h2>

        <p>
            Discover our available Umrah packages and
            prepare for a meaningful travel experience.
        </p>

        <a asp-page="/Packages" class="contact-button">
            Explore Umrah Packages
        </a>
    </div>
</section>
