@page
@{
    ViewData["Title"] = "How It Works";
}

<section class="how-hero">
    <div class="how-container">
        <span class="how-eyebrow">YOUR JOURNEY WITH BARAKAH</span>
        <h1>How It Works</h1>
        <p>
            A simple, guided process to help you prepare
            for your sacred Umrah journey.
        </p>
    </div>
</section>

<section class="how-process">
    <div class="how-container">

        <div class="how-heading">
            <span class="how-eyebrow">FOUR SIMPLE STEPS</span>
            <h2>Your Journey Starts Here</h2>
            <p>
                From registration to travel preparation,
                our online system helps you stay organised.
            </p>
        </div>

        <div class="how-grid">

            <article class="how-card">
                <span class="how-number">01</span>
                <h3>Contact Our Team</h3>
                <p>
                    Contact Barakah Travel Tours to request
                    your secure customer registration code.
                </p>
            </article>

            <article class="how-card">
                <span class="how-number">02</span>
                <h3>Create Your Account</h3>
                <p>
                    Register using your staff-issued code
                    and create your secure customer account.
                </p>
            </article>

            <article class="how-card">
                <span class="how-number">03</span>
                <h3>Choose Your Package</h3>
                <p>
                    Explore available Umrah packages,
                    compare travel dates and prices,
                    and select your preferred option.
                </p>
            </article>

            <article class="how-card">
                <span class="how-number">04</span>
                <h3>Submit Your Application</h3>
                <p>
                    Sign in to submit your application
                    and manage your travel information
                    and required documents.
                </p>
            </article>

        </div>
    </div>
</section>

<section class="how-cta">
    <div class="how-container">
        <h2>Ready to Begin?</h2>
        <p>
            Explore our Umrah packages and take the
            first step towards your sacred journey.
        </p>

        <a asp-page="/Contact" class="how-button">
            Contact our team
        </a>
    </div>
</section>
