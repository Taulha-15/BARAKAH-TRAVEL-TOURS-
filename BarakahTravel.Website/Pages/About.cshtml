@page
@{
    ViewData["Title"] = "About Us";
}

<!-- ABOUT US PHOTO BANNER -->
<section class="about-hero">
    <div class="about-hero-content">

        <h1>Our Story, Your Journey.</h1>

        <p>
            Inspired by faith. Guided by purpose.
            Dedicated to meaningful spiritual journeys.
        </p>

    </div>
</section>

<!-- INTRODUCTION -->
<section class="about-intro">
    <div class="about-intro-inner">

        <span class="about-label">
            GET TO KNOW US
        </span>

        <h2>A Journey Rooted in Faith.</h2>

        <p>
            At Barakah Travel Tours, we believe that Umrah
            is more than a travel experience. It is a sacred
            journey that deserves thoughtful preparation,
            personal attention and meaningful support.
        </p>

    </div>
</section>

<!-- OUR INSPIRATIONAL BEGINNING -->
<section class="about-story">
    <div class="about-story-inner">

        <div class="about-story-heading">
            <span class="about-label">
                OUR STORY
            </span>

            <h2>Our Inspirational Beginning</h2>
        </div>

        <div class="about-story-text">
            <p>
                Barakah Travel Tours is inspired by the
                desire to help pilgrims embark on
                meaningful journeys of faith.
            </p>

            <p>
                With the guiding message
                <strong>Towards Enlightenment</strong>,
                we strive to make preparing for Umrah
                clearer, more organised and more personal.
            </p>

            <p>
                We understand that every pilgrim's
                journey is important, and we aim
                to provide support and guidance
                throughout the travel preparation process.
            </p>
        </div>

    </div>
</section>

<!-- OUR VISION -->
<section class="about-vision">
    <div class="about-vision-inner">

        <span class="about-label">
            OUR VISION
        </span>

        <h2>Unparalleled Spiritual Experiences.</h2>

        <p>
            Our vision is to help pilgrims experience
            meaningful spiritual journeys through
            thoughtful travel planning, clear
            communication and dedicated support.
        </p>

        <div class="about-vision-line"></div>

        <p class="about-vision-quote">
            Towards Enlightenment
        </p>

    </div>
</section>

<!-- FINAL CALL TO ACTION -->
<section class="about-cta">
    <div class="about-cta-inner">

        <h2>Begin Your Sacred Journey.</h2>

        <p>
            Explore our Umrah travel packages
            and take the next step in preparing
            for your journey.
        </p>

        <a asp-page="/Packages"
           class="about-cta-button">
            Explore Umrah Packages
        </a>

    </div>
</section>
